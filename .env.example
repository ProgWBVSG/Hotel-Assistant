# Copiar a .env y completar. El .env NO se sube al repositorio.

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Solo del lado del servidor. Nunca en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# --- Envío de mails (Resend) ---
RESEND_API_KEY=
MAIL_REMITENTE=reportes@tudominio.com

# Clave propia para que solo la app pueda pedir un envío
CLAVE_ENVIO=
